SPARQL_DOMAIN=sparql.simovi.org

# Must match your existing Traefik configuration.
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# These immutable multi-platform image digests are also the Compose defaults.
# Upgrade deliberately and check index compatibility before changing QLever.
QLEVER_IMAGE=adfreiburg/qlever@sha256:32836c914eabdc9107669f154305b53708a817d1ff5b2d9881d1274dbfb174c2
QLEVER_UI_IMAGE=adfreiburg/qlever-ui@sha256:2bdbfac438c8d43ae5337bb547993b1880e5c43b63871c74ca180aa123644851

# Directory must exist and be writable by this numeric UID/GID.
QLEVER_DATA_DIR=./data/imdb
QLEVER_UID=1000
QLEVER_GID=1000
QLEVER_UI_BACKEND=imdb

# Leave headroom for index metadata, caches, and non-query memory.
QLEVER_MEMORY_LIMIT=8g
QLEVER_MEMORY_FOR_QUERIES=4G
QLEVER_CACHE_MAX_SIZE=1G
QLEVER_CACHE_SINGLE_ENTRY=256M
QLEVER_CONCURRENT_QUERIES=2
QLEVER_QUERY_TIMEOUT=60s
QLEVER_UI_MEMORY_LIMIT=512m

# Disable public SPARQL SERVICE to avoid access to internal network services.
# If needed, allow only a specific trusted HTTPS endpoint prefix.
QLEVER_SERVICE_ALLOW_PREFIX=-
